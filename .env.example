# Public build-time settings for the synthetic native environment.
# Set a trusted HTTPS service URL ending in /api/v1 for an integrated environment.
# EXPO_PUBLIC_BANKING_API_BASE_URL=https://api.tiwalo.invalid/api/v1
# After verifying ledger-backed balances, set this to the exact API base URL for that deployment.
# EXPO_PUBLIC_B3_VERIFIED_API_BASE_URL=https://api.tiwalo.invalid/api/v1
# Native customer sessions require device-reachable HTTPS for both services.
# Tokens and credentials never belong in EXPO_PUBLIC_ variables.
# Supply the exact realm issuer used by Spring and the mapped synthetic identities.
# EXPO_PUBLIC_OIDC_ISSUER=https://identity.tiwalo.invalid/realms/tiwalo
# EXPO_PUBLIC_OIDC_CLIENT_ID=tiwalo-mobile-development
# Fixture-only developer preview requires all three service settings above to be absent.
# EXPO_PUBLIC_NAVIGATION_PREVIEW=1
