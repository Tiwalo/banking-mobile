# Public build-time configuration. Leave unset for the foundation and fixture tests.
# Set a trusted HTTPS service URL ending in /api/v1 for an integrated environment.
# EXPO_PUBLIC_BANKING_API_BASE_URL=https://api.tiwalo.invalid/api/v1
# Controlled local development may use http://localhost:8081/api/v1 or the
# Android emulator host http://10.0.2.2:8081/api/v1 if the platform permits HTTP.
# Tokens and credentials never belong in EXPO_PUBLIC_ variables.
# Reserved for the native identity milestone.
# EXPO_PUBLIC_OIDC_ISSUER=https://identity.tiwalo.invalid/realms/tiwalo
# EXPO_PUBLIC_OIDC_CLIENT_ID=tiwalo-mobile-development
